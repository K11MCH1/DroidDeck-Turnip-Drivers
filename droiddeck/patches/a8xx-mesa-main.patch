+   uint32_t stride;
+   uint32_t max_count;
+   uint32_t count;
+   uint64_t count_iova;
+   uint32_t first;
+   uint32_t chunk;
+   uint32_t vertices;
+   uint32_t chunks;
+};
+
+static uint64_t
+tu_mesh_ring(const struct tu_cmd_buffer *cmd, uint32_t offset)
+{
+   return cmd->device->mesh_ring->iova + offset;
+}
